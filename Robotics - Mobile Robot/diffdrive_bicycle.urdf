<?xml version="1.0"?>
<robot name="bicycle_robot">

  <link name="world" />

  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.5 0.1 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0.3 0.3 0.7 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.5 0.1 0.1"/>
      </geometry>
    </collision>
  </link>

  <joint name="floating_base_joint" type="floating">
    <parent link="world"/>
    <child link="base_link"/>
  </joint>

  <!-- Rear wheel at x=-0.15, no steering -->
  <joint name="rear_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_wheel"/>
    <origin xyz="-0.15 0 0" rpy="1.5707 0 0"/>
  </joint>
  <link name="rear_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
  </link>

  <!-- Steering joint at x=0.15 (= front wheel center) -->
  <joint name="steering_joint" type="revolute">
    <parent link="base_link"/>
    <child link="steering_link"/>
    <origin xyz="0.15 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="10" velocity="2.0"/>
  </joint>
  <link name="steering_link"/>

  <!-- Front wheel centered exactly at steering joint -->
  <joint name="front_wheel_joint" type="fixed">
    <parent link="steering_link"/>
    <child link="front_wheel"/>
    <origin xyz="0 0 0" rpy="1.5707 0 0"/>
  </joint>
  <link name="front_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0 0 0 1"/>
      </material>
    </visual>
  </link>

</robot>
